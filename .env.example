# =============================================================================
# Litis — variables de entorno
# =============================================================================
# Copia este archivo como `.env.local` y llénalo. `.env.local` está en
# .gitignore y NUNCA debe subirse: la service role key salta toda la RLS.
# =============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Las NEXT_PUBLIC_* viajan al navegador. Es correcto: la anon key está pensada
# para eso y sin RLS no sirve de nada. La que no puede salir es la de abajo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Salta la RLS por completo. Se usa para el alta de despacho
# (cuando el usuario todavía no tiene membresía y no puede pasar ninguna
# política) y para el cron de alertas.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sitio ───────────────────────────────────────────────────────────────────
# El origen de los enlaces de correo sale de AQUÍ, nunca del header `Host`:
# quien manda la petición controla ese header, y con él puede hacer que un
# correo legítimo de recuperación lleve el token a su propio servidor.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Correo (Resend) ─────────────────────────────────────────────────────────
# Sin API key el envío se simula y se escribe en consola: el flujo se puede
# probar entero sin cuenta.
RESEND_API_KEY=
# Remitente. Resend exige un dominio verificado; sin esto usa el de pruebas.
CORREO_REMITENTE=
# A dónde avisar cuando la corrida de alertas se rompe. Sin esto solo se
# escribe en la consola del servidor, que es donde nadie mira.
CORREO_ALERTAS=

# ── Cron de alertas de plazos ───────────────────────────────────────────────
# Protege GET /api/cron/alertas-plazos. Sin este valor el endpoint responde 503
# en vez de quedar abierto: un endpoint abierto que manda correo es un cañón de
# spam apuntando a los clientes del despacho.
#
#   openssl rand -base64 32
#
# El crontab del servidor:
#   0 7 * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" \
#     https://TU-DOMINIO/api/cron/alertas-plazos
CRON_SECRET=

# ── Cobro de la suscripción (Stripe) ────────────────────────────────────────
# Sin llaves, el módulo corre en modo simulación.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
